{
  "kind": "collectionType",
  "collectionName": "readings_groups",
  "info": {
    "name": "ReadingsGroup",
    "displayName": "Grupy czytań"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "visible_from": {
      "type": "datetime",
      "required": true
    },
    "visible_to": {
      "type": "datetime",
      "required": true
    },
    "image": {
      "model": "file",
      "via": "related",
      "allowedTypes": [
        "images"
      ],
      "plugin": "upload",
      "required": false,
      "pluginOptions": {}
    },
    "photo": {
      "model": "photos",
      "via": "readings_groups"
    },
    "readings": {
      "collection": "readings",
      "via": "readings_group"
    }
  }
}
